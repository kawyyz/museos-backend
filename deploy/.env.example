# Copiar como /opt/museos/.env en el servidor y completar. NO subir el archivo real a GitHub.

POSTGRES_DB=museos
POSTGRES_USER=museos
# Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=
# Generar con: openssl rand -base64 32
JWT_SECRET=
ADMIN_PASSWORD=
# Dirección pública de la aplicación (http://IP_ELASTICA)
CORS_ORIGINS=http://IP_ELASTICA

# Región de AWS (para CloudWatch Logs)
AWS_REGION=us-east-1

# Archivos de compose a usar. Con CloudWatch activado:
#   COMPOSE_FILE=docker-compose.prod.yml:docker-compose.logs.yml
COMPOSE_FILE=docker-compose.prod.yml
